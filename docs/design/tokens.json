{
  "$description": "MOCHI design tokens. Single source of truth for values. styles.css and components must use these values (as CSS variables or imported JSON). Change only with JJ's approval.",
  "color": {
    "cream": "#F2EDE4",
    "milk": "#FAF7F2",
    "ink": "#141414",
    "ink60": "rgba(20,20,20,0.6)",
    "ink40": "rgba(20,20,20,0.4)",
    "hairline": "rgba(20,20,20,0.18)",
    "selection": { "background": "#B3122E", "text": "#FAF7F2" }
  },
  "flavours": [
    { "key": "cherry", "name": "CHERRY", "mood": "loud",  "jelly": "#B3122E", "aura": "#2FA4A8", "index": "01" },
    { "key": "peach",  "name": "PEACH",  "mood": "easy",  "jelly": "#F4A27E", "aura": "#8FC3E6", "index": "02" },
    { "key": "lychee", "name": "LYCHEE", "mood": "quiet", "jelly": "#F6D3D6", "aura": "#E46A8E", "index": "03" },
    { "key": "grape",  "name": "GRAPE",  "mood": "late",  "jelly": "#8E5BC4", "aura": "#F08A3C", "index": "04" },
    { "key": "mint",   "name": "MINT",   "mood": "fresh", "jelly": "#8FD9B6", "aura": "#14524A", "index": "05" },
    { "key": "mango",  "name": "MANGO",  "mood": "sunny", "jelly": "#F2B632", "aura": "#2346B8", "index": "06" }
  ],
  "sectionAura": {
    "$description": "Global WebGL aura colours per section [ring, glow]. Blend between neighbours over at least 40vh of scroll.",
    "hero": ["#F2EDE4", "#F6D3D6"],
    "belief": ["#2FA4A8", "#E46A8E"],
    "squeeze": ["#2FA4A8", "#F2EDE4"],
    "flavours": ["activeFlavour.aura", "#F2EDE4"],
    "texture": ["#8FC3E6", "#F4A27E"],
    "lookbook": ["#F2EDE4", "#F6D3D6"],
    "stand": ["#8FC3E6", "#F2EDE4"],
    "allSix": ["#E46A8E", "#F2B632"],
    "wallpapers": ["#2346B8", "#F2EDE4"],
    "footer": ["#2346B8", "#B3122E"]
  },
  "font": {
    "display": { "family": "Krona One", "file": "/fonts/krona-one-400-normal.ttf", "weight": 400, "tracking": "-0.03em", "case": "lowercase" },
    "emotion": { "family": "Instrument Serif", "package": "@fontsource/instrument-serif", "style": "italic", "weight": 400, "tracking": "-0.01em" },
    "body":    { "family": "Geist", "package": "@fontsource-variable/geist", "weights": [400, 500], "tracking": "0" },
    "data":    { "family": "Geist Mono", "package": "@fontsource-variable/geist-mono", "weights": [400, 500], "tracking": "0.1em", "case": "uppercase" },
    "fallbackRule": "Use size-adjust fallback metrics; Arial or Consolas must never be visible."
  },
  "typeScale": {
    "displayXL": "clamp(64px, 11vw, 220px)",
    "displayL": "clamp(48px, 8.5vw, 160px)",
    "displayM": "clamp(36px, 5vw, 96px)",
    "emotionL": "clamp(52px, 9vw, 180px)",
    "body": "clamp(18px, 1.4vw, 22px)",
    "bodyLeading": 1.45,
    "displayLeading": 0.92,
    "mono": "12px",
    "monoMobile": "11px",
    "minimum": "11px"
  },
  "space": [4, 8, 16, 24, 40, 64, 104, 168],
  "grid": { "columns": 12, "gutter": "24px", "margin": "64px", "marginMobile": "20px", "maxWidth": "none" },
  "shape": { "radius": "0", "boxShadow": "none", "hairline": "1px solid rgba(20,20,20,0.18)", "rule": "Only products are curved. No pills, chips, cards or circles in the UI." },
  "motion": {
    "springs": {
      "ui":     { "stiffness": 380, "damping": 38, "mass": 1,   "use": "nav, text CTAs, labels; no visible bounce" },
      "settle": { "stiffness": 170, "damping": 26, "mass": 1,   "use": "panels, images, layout" },
      "jelly":  { "stiffness": 120, "damping": 9,  "mass": 1,   "use": "products and jelly type only; 2–3 visible wobbles" },
      "heavy":  { "stiffness": 90,  "damping": 20, "mass": 2.5, "use": "the stand, wallpaper stack, large objects" }
    },
    "reveal": { "ease": "expo.out", "duration": "1.0–1.2s", "stagger": 0.025, "from": "yPercent 110 inside a line mask" },
    "press": { "scale": 0.97, "spring": "ui", "on": "pointerdown" },
    "momentum": { "decelerationRate": 0.998 },
    "rubberBand": { "constant": 0.55 },
    "lenis": { "lerp": 0.08 },
    "velocity": { "maxSkewDeg": 2.5, "maxProductStretchY": 1.03, "maxProductBendDeg": 4 },
    "grain": { "opacity": 0.05, "fps": 8 }
  },
  "hero": {
    "video": "/media/video/hero-six.mp4",
    "frames": { "desktop": "/media/hero-seq/desk/%04d.webp (172)", "mobile": "/media/hero-seq/mob/%04d.webp (86)" },
    "pin": { "desktop": "220vh", "mobile": "160vh" },
    "tubeCentresX": [0.184, 0.313, 0.444, 0.572, 0.700, 0.828],
    "keepClear": "bottom-right corner (Veo watermark)"
  },
  "wallpapers": { "size": "1290 × 2796" }
}
